[Unit]
Description=KaiT2en rescue console for an installed system
Documentation=https://github.com/kaiT2en/KaiT2en-Fedora
ConditionKernelCommandLine=kait2en.rescue
Conflicts=getty@tty1.service
After=getty@tty1.service systemd-user-sessions.service

[Service]
Type=idle
ExecStart=/run/kait2en/kait2en-live-rescue
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
