From 9bf220b40fe6a1a2372ef3481026eeab5582c490 Mon Sep 17 00:00:00 2001
From: Alexander Fischer <alexander.fischer@kait2en.org>
Date: Wed, 26 Aug 2026 17:54:36 +0200
Subject: [PATCH 1/3] drm/i915/psr: add Apple eDP TCON PSR handshake quirk

Apple eDP panels carry a TCON that does not enter self refresh when only
DP_PSR_EN_CFG is written. The sink acknowledges the write, but stays in
DP_PSR_SINK_INACTIVE and never captures a frame.

Tracing AppleIntelPort::writeAUX() under macOS 15.7.7 on a MacBookPro16,2
shows the panel being set up through three vendor DPCD registers before
DP_PSR_EN_CFG is written, and a capture trigger written to DPCD 0x4d4
afterwards. The same trace shows that macOS never sets
DP_PSR_CRC_VERIFICATION on these panels, and with that bit set the TCON
does not capture a frame either.

Add the sequence as a DPCD quirk keyed on the Apple sink OUI 00:10:fa.
The quirk also overrides psr_global_enabled(), because the VBT on these
machines leaves the PSR enable bit clear even though the panel supports
PSR and works with it.

Match on the sink OUI alone rather than on the panel device ID: Apple
ships different panels behind identical device IDs, a MacBookPro15,1 and
a MacBookPro16,1 both report 65 44 15 67 62 61 while differing in DPCD
revision, maximum link rate and PSR capabilities. The OUI is Apple's own
and cannot match third party hardware, and panels that do not support PSR
never reach this code because _psr_init_dpcd() bails out on
DP_PSR_SUPPORT before the quirk is consulted.

This has no effect on its own. PSR on Apple panels is still blocked by
DP_DPCD_QUIRK_NO_PSR, which the next patch removes.

Signed-off-by: Alexander Fischer <alexander.fischer@kait2en.org>
---
 drivers/gpu/drm/i915/display/intel_psr.c    | 34 ++++++++++++++++++++-
 drivers/gpu/drm/i915/display/intel_quirks.c | 17 +++++++++++
 drivers/gpu/drm/i915/display/intel_quirks.h |  1 +
 3 files changed, 51 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/i915/display/intel_psr.c b/drivers/gpu/drm/i915/display/intel_psr.c
index 598fe76..9f847ca 100644
--- a/drivers/gpu/drm/i915/display/intel_psr.c
+++ b/drivers/gpu/drm/i915/display/intel_psr.c
@@ -243,6 +243,10 @@ static bool psr_global_enabled(struct intel_dp *intel_dp)
 
 	switch (intel_dp->psr.debug & I915_PSR_DEBUG_MODE_MASK) {
 	case I915_PSR_DEBUG_DEFAULT:
+		/* Apple VBTs leave the PSR bit clear on panels that do support it */
+		if (intel_has_dpcd_quirk(intel_dp, QUIRK_APPLE_PSR_HANDSHAKE))
+			return true;
+
 		return intel_dp_is_edp(intel_dp) ?
 			connector->panel.vbt.psr.enable : true;
 	case I915_PSR_DEBUG_DISABLE:
@@ -812,19 +816,42 @@ static void _panel_replay_enable_sink(struct intel_dp *intel_dp,
 			   panel_replay_config2);
 }
 
+/* Apple eDP TCON vendor DPCD registers, taken from macOS AUX traces */
+#define APPLE_PSR_UNLOCK		0x321
+#define APPLE_PSR_UNLOCK_VENDOR_CFG	0x3c
+#define APPLE_PSR_CFG1			0x4d1
+#define APPLE_PSR_CFG1_ENABLE		0x03
+#define APPLE_PSR_CFG2			0x4d2
+#define APPLE_PSR_CFG2_ENABLE		0x01
+#define APPLE_PSR_TRIGGER		0x4d4
+#define APPLE_PSR_TRIGGER_CAPTURE	0x01
+
+static void _psr_apple_unlock_sink(struct intel_dp *intel_dp)
+{
+	drm_dp_dpcd_writeb(&intel_dp->aux, APPLE_PSR_UNLOCK,
+			   APPLE_PSR_UNLOCK_VENDOR_CFG);
+	drm_dp_dpcd_writeb(&intel_dp->aux, APPLE_PSR_CFG2, APPLE_PSR_CFG2_ENABLE);
+	drm_dp_dpcd_writeb(&intel_dp->aux, APPLE_PSR_CFG1, APPLE_PSR_CFG1_ENABLE);
+}
+
 static void _psr_enable_sink(struct intel_dp *intel_dp,
 			     const struct intel_crtc_state *crtc_state)
 {
 	struct intel_display *display = to_intel_display(intel_dp);
+	bool apple_tcon = intel_has_dpcd_quirk(intel_dp, QUIRK_APPLE_PSR_HANDSHAKE);
 	u8 val = 0;
 
+	if (apple_tcon)
+		_psr_apple_unlock_sink(intel_dp);
+
 	if (crtc_state->has_sel_update) {
 		val |= DP_PSR_ENABLE_PSR2 | DP_PSR_IRQ_HPD_WITH_CRC_ERRORS;
 	} else {
 		if (intel_dp->psr.link_standby)
 			val |= DP_PSR_MAIN_LINK_ACTIVE;
 
-		if (DISPLAY_VER(display) >= 8)
+		/* The Apple TCON never captures a frame with CRC verification set */
+		if (DISPLAY_VER(display) >= 8 && !apple_tcon)
 			val |= DP_PSR_CRC_VERIFICATION;
 	}
 
@@ -840,6 +867,11 @@ static void _psr_enable_sink(struct intel_dp *intel_dp,
 
 	val |= DP_PSR_ENABLE;
 	drm_dp_dpcd_writeb(&intel_dp->aux, DP_PSR_EN_CFG, val);
+
+	/* DP_PSR_EN_CFG alone does not arm the Apple TCON, 0x4d4 is the trigger */
+	if (apple_tcon)
+		drm_dp_dpcd_writeb(&intel_dp->aux, APPLE_PSR_TRIGGER,
+				   APPLE_PSR_TRIGGER_CAPTURE);
 }
 
 static void intel_psr_enable_sink(struct intel_dp *intel_dp,
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.c b/drivers/gpu/drm/i915/display/intel_quirks.c
index 883f297..93c1c33 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.c
+++ b/drivers/gpu/drm/i915/display/intel_quirks.c
@@ -94,6 +94,14 @@ static void quirk_disable_edp_panel_replay(struct intel_dp *intel_dp)
 	drm_info(display->drm, "Applying disable Panel Replay quirk\n");
 }
 
+static void quirk_apple_psr_handshake(struct intel_dp *intel_dp)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+
+	intel_set_dpcd_quirk(intel_dp, QUIRK_APPLE_PSR_HANDSHAKE);
+	drm_info(display->drm, "Applying Apple PSR handshake quirk\n");
+}
+
 struct intel_quirk {
 	int device;
 	int subsystem_vendor;
@@ -269,6 +277,15 @@ static const struct intel_dpcd_quirk intel_dpcd_quirks[] = {
 		.sink_oui = SINK_OUI(0x00, 0x22, 0xb9),
 		.hook = quirk_disable_edp_panel_replay,
 	},
+	/* Apple eDP panels */
+	{
+		.device = DEVICE_ID_ANY,
+		.subsystem_vendor = PCI_ANY_ID,
+		.subsystem_device = PCI_ANY_ID,
+		.sink_oui = SINK_OUI(0x00, 0x10, 0xfa),
+		.sink_device_id = SINK_DEVICE_ID_ANY,
+		.hook = quirk_apple_psr_handshake,
+	},
 };
 
 void intel_init_quirks(struct intel_display *display)
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.h b/drivers/gpu/drm/i915/display/intel_quirks.h
index 83214eb..2211b2c 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.h
+++ b/drivers/gpu/drm/i915/display/intel_quirks.h
@@ -22,6 +22,7 @@ enum intel_quirk_id {
 	QUIRK_FW_SYNC_LEN,
 	QUIRK_EDP_LIMIT_RATE_HBR2,
 	QUIRK_DISABLE_EDP_PANEL_REPLAY,
+	QUIRK_APPLE_PSR_HANDSHAKE,
 };
 
 void intel_init_quirks(struct intel_display *display);
