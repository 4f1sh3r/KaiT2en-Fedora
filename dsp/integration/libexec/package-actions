#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Every independent lifecycle action is attempted and reported.
set -uo pipefail
errors=()
root=${T2_DSP_TEST_ROOT:-}
log_file="$root/var/log/t2-dsp-install.log"

report() {
    errors+=("$*")
    printf '[t2-dsp] error: %s\n' "$*" >&2
    if ! printf '%s\n' "$*" >>"$log_file"; then
        printf '[t2-dsp] error: cannot append to %s\n' "$log_file" >&2
    fi
}

run() {
    local status
    "$@"
    status=$?
    if (( status != 0 )); then report "$* failed (status $status)"; fi
    return "$status"
}

retire() {
    local path=$1 pattern=$2 file backup
    file="$root$path"
    [[ -e "$file" || -L "$file" ]] || return 0
    if [[ -L "$file" || ! -f "$file" ]]; then
        report "not migrating non-regular file $path. Review it before reboot"
        return 0
    fi
    if ! grep -Eq "$pattern" "$file"; then
        report "unrecognized local configuration left unchanged: $path. Review it before reboot to avoid duplicate DSP filters"
        return 0
    fi
    # Keep exact copies of former configuration, never discard user data.
    if ! run mkdir -p "$root/var/lib/t2-dsp/migration"; then return 0; fi
    if ! backup=$(mktemp "$root/var/lib/t2-dsp/migration/${path##*/}.XXXXXX"); then
        report "cannot allocate backup for $path"
        return 0
    fi
    if run cp -p -- "$file" "$backup"; then
        if run rm -- "$file"; then
            printf '[t2-dsp] migrated %s. Backup: %s\n' "$path" "$backup"
        fi
    fi
}

migrate() {
    retire /etc/wireplumber/wireplumber.conf.d/51-kait2en-t2-dsp.conf '^# Generated by scripts/fedora/install-dsp.sh for '
    retire /etc/pipewire/pipewire.conf.d/50-kait2en-quantum.conf '^# Generated by scripts/fedora/install-dsp.sh$'
    # No reliable ownership markers for older filenames. Do not guess.
    local file
    shopt -s nullglob
    for file in "$root"/etc/wireplumber/wireplumber.conf.d/51-t2-dsp.conf \
                "$root"/etc/pipewire/pipewire.conf.d/t2_*_speakers.conf \
                "$root"/etc/pipewire/pipewire.conf.d/t2_*_mic.conf \
                "$root"/etc/udev/rules.d/99-t2-audio-rename.rules \
                "$root"/usr/lib/udev/rules.d/99-t2-audio-rename.rules \
                "$root"/usr/share/wireplumber/scripts/device/t2-force-unmute.lua; do
        if [[ -e "$file" || -L "$file" ]]; then
            report "legacy configuration left unchanged: ${file#"$root"}. Review it before reboot"
        fi
    done
}

case "${1:-}" in
    configure)
        migrate
        # Test roots are offline. Never reach the host's udev daemon.
        if [[ -z "$root" && -d /run/udev ]]; then run udevadm control --reload-rules; fi
        printf '[t2-dsp] Reboot to activate model IDs and DSP. No audio services were restarted.\n'
        ;;
    removed)
        if [[ -z "$root" && -d /run/udev ]]; then run udevadm control --reload-rules; fi
        printf '[t2-dsp] Reboot to finish removing DSP. Migration backups were preserved.\n'
        ;;
    *) report "expected configure or removed" ;;
esac

if (( ${#errors[@]} )); then
    printf '[t2-dsp] completed with %s errors/warnings:\n' "${#errors[@]}" >&2
    printf '  - %s\n' "${errors[@]}" >&2
    printf '[t2-dsp] report: %s\n' "$log_file" >&2
    if [[ -n "${KAIT2EN_INSTALL_ERRORS:-}" ]]; then
        for error in "${errors[@]}"; do
            if ! printf 't2-dsp: %s\n' "$error" >>"$KAIT2EN_INSTALL_ERRORS"; then
                printf '[t2-dsp] error: cannot append to installer report\n' >&2
            fi
        done
    fi
else
    printf '[t2-dsp] completed without recorded errors\n'
fi
exit 0
